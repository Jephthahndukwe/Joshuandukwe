# WebinarJam API (Settings > Integrations > API in WebinarJam). Leave blank to use the built-in fallback.
WEBINARJAM_API_KEY=
WEBINARJAM_WEBINAR_ID=
# Schedule index to register people into (0 = first schedule on the webinar)
WEBINARJAM_SCHEDULE=0
# Joshua's WebinarJam live room link: used for the Join the Training button when WebinarJam does not pass a personal link
NEXT_PUBLIC_FALLBACK_ROOM_URL=

# Public site URL (custom domain) and support email shown on the confirm page
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
